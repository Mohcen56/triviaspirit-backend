# Application
NODE_ENV=development
PORT=8000
APP_SECRET=generate-with-openssl-rand-hex-32
ADMIN_COOKIE_SECRET=generate-a-different-value-with-openssl-rand-hex-32
PBKDF2_ITERATIONS=870000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to the number of trusted reverse-proxy hops; false is safest for direct access.
TRUST_PROXY=false

# PostgreSQL / Neon. DATABASE_URL is preferred; NEON_DATABASE_URL is also accepted.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SYNCHRONIZE=false
DATABASE_MIGRATIONS_RUN=false
DATABASE_LOGGING=false

# Media (local defaults)
MEDIA_ROOT=media
MEDIA_PUBLIC_URL=http://localhost:8000/media

# Cloudflare R2 (leave blank to use local media storage)
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_ENDPOINT=
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_TEST_MODE=

# ZeptoMail
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_ENDPOINT=https://api.zeptomail.eu/
DEFAULT_FROM_EMAIL=support@example.com
ALLOW_RESET_LINK_LOGGING=false
